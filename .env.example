# Non-secret defaults are shown here. Real deployment secrets live in
# /etc/homelab/music-video-grabber.env on docker-server.
MVG_API_TOKEN=replace-with-a-long-random-token
MVG_DATABASE_PATH=/data/music-video-grabber.db
MVG_MEDIA_DIR=/media
MVG_STAGING_DIR=/media/.music-video-grabber-staging
MVG_LEGACY_JSON_PATH=/import/altnation-songs.json
MVG_YOUTUBE_COOKIE_FILE=/run/secrets/youtube-cookies.txt
MVG_AUTO_APPROVE_SCORE=88
MVG_AUTO_APPROVE_MARGIN=8
MVG_MAX_RESULTS=8
MVG_MAX_DOWNLOAD_HEIGHT=1080
MVG_MAILRISE_HOST=apprise-mailrise
MVG_MAILRISE_PORT=8025
MVG_NOTIFICATION_TO=telegram@mailrise.xyz
MVG_NOTIFICATION_FROM=music-video-grabber@pelorus.org
MVG_PERSONAL_MTV_SCAN_URL=http://192.168.0.181:8000/api/scan
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
